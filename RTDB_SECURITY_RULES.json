{
  "rules": {
    "omok": {
      ".read": "auth != null",
      ".write": "auth != null",
      "users": {
        "$uid": {
          ".read": "auth != null",
          ".write": "$uid === auth.uid",
          "fcmToken": { ".validate": "newData.isString()" },
          "nickname": { ".validate": "newData.isString() && newData.val().length <= 20" }
        }
      },
      "audio": {
        "$gameId": {
          ".read": "auth != null",
          ".write": "auth != null",
          "$uid": {
            ".write": "$uid === auth.uid",
            "$sequence": {
              ".validate": "newData.hasChildren(['sequence', 'samples', 'timestamp']) && newData.child('sequence').isNumber() && newData.child('timestamp').isNumber()"
            }
          }
        }
      },
      "games": {
        "$gameId": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || data.child('createdBy').val() === auth.uid || data.child('players').child(auth.uid).exists() || newData.child('createdBy').val() === auth.uid)",
          "status":    { ".validate": "newData.isString() && newData.val().matches(/^(waiting|playing|finished)$/)" },
          "turn":      { ".validate": "newData.val() === 'black' || newData.val() === 'white'" },
          "round":     { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "moveCount": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 225" },
          "result":    { ".validate": "newData.val() === 'black' || newData.val() === 'white' || newData.val() === 'draw'" },
          "createdBy": { ".validate": "newData.isString()" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "updatedAt": { ".validate": "newData.isNumber()" },
          "lastMove": {
            ".validate": "newData.hasChildren(['r', 'c', 'color'])",
            "r":     { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 15" },
            "c":     { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 15" },
            "color": { ".validate": "newData.val() === 'black' || newData.val() === 'white'" }
          },
          "winningLine": {
            "$index": {
              ".validate": "newData.hasChildren(['r', 'c'])",
              "r": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 15" },
              "c": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 15" }
            }
          },
          "board": {
            "$cell": {
              ".validate": "$cell.matches(/^[0-9]{1,2}_[0-9]{1,2}$/) && (newData.val() === 'black' || newData.val() === 'white') && (!data.exists() || data.val() === newData.val())"
            }
          },
          "players": {
            "$uid": {
              ".validate": "newData.hasChild('color')",
              "color": { ".validate": "newData.val() === 'black' || newData.val() === 'white'" },
              "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20" },
              "joinedAt": { ".validate": "newData.isNumber()" },
              "active": { ".validate": "newData.isBoolean()" }
            }
          },
          "scores": {
            "$uid": { ".validate": "newData.isNumber() && newData.val() >= 0" }
          },
          "rematch": {
            "$uid": { ".validate": "($uid === auth.uid || $uid === 'ai-player') && newData.val() === true" }
          },
          "undoRequest": {
            "requestedBy": { ".validate": "newData.isString() && newData.val() === auth.uid" },
            "createdAt": { ".validate": "newData.isNumber()" }
          },
          "audioFrames": {
            "$frameId": {
              ".validate": "newData.hasChildren(['sequence', 'samples', 'timestamp'])"
            }
          },
          "previousLastMove": {
            ".validate": "newData.hasChildren(['r', 'c', 'color'])",
            "r":     { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 15" },
            "c":     { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 15" },
            "color": { ".validate": "newData.val() === 'black' || newData.val() === 'white'" }
          },
          "speaking": {
            "$color": {
              ".validate": "($color === 'black' || $color === 'white') && newData.isBoolean()"
            }
          },
          "timerDuration": { ".validate": "(newData.val() === 10 || newData.val() === 20 || newData.val() === 30 || newData.val() === 60) && (!data.exists() || data.val() === newData.val())" },
          "turnStartedAt": { ".validate": "newData.isNumber()" }
        }
      }
    }
  }
}
